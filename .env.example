# Database - use a Postgres connection string (Neon, Supabase, Railway, etc. all work)
# For local dev you can point this at a local Postgres, or swap the provider in
# prisma/schema.prisma to "sqlite" and use DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://user:password@host:5432/badmoms?sslmode=require"

# Session secret - generate any random long string, e.g. `openssl rand -base64 32`
SESSION_SECRET="replace-this-with-a-long-random-string"

# Resend.com API key for sending emails (free tier is fine to start)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Bad Moms Christmas <sponsorship@yourdomain.org>"

# Org details shown in emails / pages
ORG_NAME="Bad Moms Christmas"
DROPOFF_LOCATION="Legend Realty, South Parkway"
DROPOFF_DATE="December 20"
DROPOFF_WINDOW="9:00 AM - 11:00 AM"
PICKUP_WINDOW="1:00 PM - 4:00 PM"
SUBMISSION_DEADLINE="October 31"
